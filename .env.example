# Multi-voice casting (beta). Without a key the app still works — it just
# narrates prose in the single voice picked in the UI. Scripts written as
# "NAME: line" are still fully cast, since they say who is speaking.
# Get one at https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# openai/gpt-oss-20b casts most accurately (~9s of analysis before audio starts).
# meta/llama-3.1-8b-instruct is ~3s quicker but mixes up who says what.
NVIDIA_MODEL=openai/gpt-oss-20b

# Where the frontend is served from. Comma-separated; the deployed URL must be
# listed here or the browser blocks every request.
CORS_ORIGINS=http://localhost:5173,https://suno-story.vercel.app

# Finished audio is kept only long enough to press Download. Nothing survives a
# restart regardless.
AUDIO_TTL_SECONDS=900
AUDIO_SWEEP_SECONDS=120
AUDIO_CACHE_MAX_MB=300

# Upstreams are shared free tiers; these queue work instead of hammering them.
MAX_CONCURRENT_TTS=6
MAX_CONCURRENT_CASTING=3

LOG_LEVEL=INFO
