# Casts the story: works out who speaks each line, and whether they are a man or
# a woman. Without it the app still works — edge-tts voices narrate as usual, and
# scripts written as "NAME: line" are still fully cast, since they say who is
# speaking. Get one at https://build.nvidia.com
NVIDIA_API_KEY=

# Speaks the story. Comma-separated: every key listed is used in turn, each with
# its own pacing and its own cooldown.
#
# A reading spends requests, not characters. Multi-voice cannot merge across
# speakers — each turn is a different voice — so 2,370 characters of dialogue
# leaves as 61 requests averaging 36 characters, against a 700-character cap.
# What the service caps is how many are in flight, counted per key: four on each
# of two keys went through together where eight on one did not. A second key is
# therefore a second set of slots, and it keeps speech from competing with the
# casting model. Blank runs speech on NVIDIA_API_KEY.
MAGPIE_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# openai/gpt-oss-20b casts most accurately (~9s of analysis before audio starts).
# meta/llama-3.1-8b-instruct is ~3s quicker but mixes up who says what.
NVIDIA_MODEL=openai/gpt-oss-20b

# Where the frontend is served from. Comma-separated; the deployed URL must be
# listed here or the browser blocks every request.
CORS_ORIGINS=http://localhost:5173,https://suno-story.vercel.app

# Finished audio is kept only long enough to press Download. Nothing survives a
# restart regardless.
AUDIO_TTL_SECONDS=7200
AUDIO_SWEEP_SECONDS=120
AUDIO_CACHE_MAX_MB=300

# NVIDIA Magpie voices, used when one is picked in the UI. It returns a whole
# WAV rather than a stream, so the reading is cut into pieces and several are
# synthesised ahead of the one being played.
MAGPIE_MAX_CHARS=700
MAGPIE_OPENING_CHARS=220
# Pieces kept in flight ahead of the one playing. Wants to match the total
# concurrency the keys allow, or the spare slots go unused.
MAGPIE_PREFETCH=8
# How long a key is left alone after refusing several times in a row. A 429 is
# too many at once, not a spent quota, so it clears quickly.
MAGPIE_COOLDOWN_SECONDS=60
# A second between calls, if the service ever does start rate-limiting. It does
# not today — fifteen back to back were all answered — so this is 0 and the only
# limit respected is how many may be in flight at once.
MAGPIE_MIN_INTERVAL=1.0

# Upstreams are shared free tiers; these queue work instead of hammering them.
MAX_CONCURRENT_TTS=6
MAX_CONCURRENT_CASTING=3
# Per key, not in total. Four at once are answered and the fifth is refused, and
# the cap is counted per key — so two keys carry eight.
MAX_CONCURRENT_MAGPIE=4

# Multi-voice is judged on the model calls a text creates, not its length —
# long prose is cheap, rapid dialogue is not. Raise to cast bigger stories.
CASTING_MAX_BATCHES=60

# How hard the model thinks about who is speaking each line: low, medium, high.
# Higher places lines more reliably but lengthens the wait before audio starts,
# since the first batch is the one the opening word waits on. gpt-oss only.
CASTING_REASONING_EFFORT=low

# Silence between the separately synthesised pieces, chosen by the punctuation
# the last one ended on. Without it a full stop gets no breath and the reading
# gallops. PAUSE_SPEAKER_SECONDS is the beat held before a different voice.
PAUSE_SENTENCE_SECONDS=0.45
PAUSE_CLAUSE_SECONDS=0.18
PAUSE_DEFAULT_SECONDS=0.25
PAUSE_SPEAKER_SECONDS=0.6

# Warnings and errors only. LOG_LEVEL=INFO shows what casting decided.
LOG_LEVEL=WARNING
